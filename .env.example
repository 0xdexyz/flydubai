# Copy this file to ".env" (never commit .env) and fill it in YOURSELF.
# Never paste a key into chat, code or git. Use a NEW wallet that holds only devnet test SOL.

# Secret key of the payout wallet (base58 string, or the JSON array from a Solana CLI keypair file).
# Leave it empty to keep payouts off. Fund this wallet's public address with devnet SOL at
# https://faucet.solana.com (choose "devnet").
PAYOUT_SECRET_KEY=

# DEVNET ONLY. The server refuses to send unless this is devnet AND the RPC really is devnet
# (it checks the network's genesis hash), so mainnet can never be touched by mistake.
SOLANA_CLUSTER=devnet
SOLANA_RPC=https://api.devnet.solana.com

# Rules and safety caps
REWARD_SOL=0.01                      # paid per safe landing
WITHDRAW_MIN_SOL=1                  # minimum withdrawal
MAX_REWARDS_PER_PILOT_PER_DAY=20     # paid landings per pilot per UTC day
MAX_WITHDRAWALS_PER_PILOT_PER_DAY=3
DAILY_BUDGET_SOL=3                     # all withdrawals together per UTC day (a single withdrawal is 1 SOL or more)
REWARD_MIN_FLIGHT_MS=90000           # a landing faster than this earns no reward

# --- Deployment ---------------------------------------------------------------------------
# Set these in your host's environment settings (do not ship a .env file to the server).
NODE_ENV=production
PORT=8791
# Where pilots, rewards and payout records are stored. Use a persistent disk/volume,
# otherwise every redeploy starts empty.
DATA_DIR=/data
# How many reverse proxies (Render, Railway, Nginx, Cloudflare...) sit in front of this app.
# Needed so rate limits and the sign-up limit see each player's real address.
TRUST_PROXY=1
# Only if the game is served from a different origin than the API.
# ALLOWED_ORIGIN=https://your-domain.example
RATE_LIMIT_PER_MIN=300
# The owner-only wallet panel is off in production. Set OWNER_PANEL=1 only to turn it on deliberately.
# OWNER_PANEL=0
